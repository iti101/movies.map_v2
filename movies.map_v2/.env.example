# Copy this file to `.env.local` and restart `npm run dev` after changing it.
# Vite inlines VITE_* at process start.

# TMDB v3 API key (query param `api_key`, not a v4 bearer token).
# Create one at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Novi education project id (header `novi-education-project-id`).
# Needed for sign-in, account creation, and reviews.
VITE_NOVI_PROJECT_ID=

# Optional. Used by production / `npm run preview` only.
# `npm run dev` ignores this and proxies `/novi-api` (see vite.config.js).
# VITE_NOVI_API_URL=https://novi-backend-api-wgsgz.ondigitalocean.app
